NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/fleetflow
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12
ALLOW_PUBLIC_REGISTRATION=false

# Private document uploads (store outside the public web root in production)
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_BYTES=10485760
PUBLIC_API_URL=http://localhost:4000

CLIENT_URL=http://localhost:5173
# Configure a transactional email provider before production account verification/reset and OTP tracking
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional self-hosted Traccar GPS integration
TRACCAR_BASE_URL=
TRACCAR_USERNAME=
TRACCAR_PASSWORD=
