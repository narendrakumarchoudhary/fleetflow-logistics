# Frontend Vercel project environment variable
# Set this to the public Render API URL including /api, for example:
# VITE_API_URL=https://fleetflow-api.onrender.com/api
VITE_API_URL=

# Backend Render environment variables (set these in Render dashboard)
NODE_ENV=production
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=
PUBLIC_API_URL=
BCRYPT_ROUNDS=12
ALLOW_PUBLIC_REGISTRATION=false
UPLOAD_DIR=/opt/render/project/src/storage/uploads
MAX_UPLOAD_BYTES=10485760
