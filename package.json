{
  "name": "fleetflow-logistics",
  "private": true,
  "version": "1.4.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test": "npm run test -w server",
    "setup": "node scripts/setup.js",
    "verify": "npm test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "India-localised logistics operations management application",
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
